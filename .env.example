# Copy this file to .env and adjust the values for your setup, then run
# `docker compose up -d`. The paths below are host paths; the container
# always sees them at /data/registry, /data/roms and /data/config.

# Host port the web UI is exposed on.
PORT=8080

# The container runs as a non-root user, uid:gid 65532:65532 by default —
# every folder it writes to (REGISTRY_FOLDER, CONFIG_FOLDER, and
# ROMS_FOLDER if it's meant to be written to) must be owned by that uid, or
# the server gets a permission error the moment it tries to write. Before
# the first `docker compose up`:
#   sudo mkdir -p "$REGISTRY_FOLDER" "$CONFIG_FOLDER"
#   sudo chown -R 65532:65532 "$REGISTRY_FOLDER" "$CONFIG_FOLDER"
#
# On some setups a plain chown to 65532 isn't enough — most notably a
# Synology shared folder, which layers an ACL (`ls -lan` shows a trailing
# "+" on its permissions) on top of standard Unix ownership. The ACL only
# recognizes actual DSM users, not an arbitrary uid like 65532, and
# overrides the classic permission bits entirely, so it silently refuses
# the write no matter what chown or chmod says. In that case, don't fight
# the ACL: leave PUID/PGID below at their default (commented out) if you
# did successfully chown to 65532, or instead set them to the uid:gid that
# already owns the folder (the one that created it, e.g. your own DSM
# account — find it by running `ls -lan` on the folder and reading the
# owner column) so the container runs as a user the ACL already trusts.
#PUID=1026
#PGID=100

# Host path to the registry folder.
REGISTRY_FOLDER=/path/to/registry

# Host path to the PARENT directory holding your Batocera ROMs folders, one
# subfolder per system (e.g. /userdata/roms/snes, /userdata/roms/megadrive on
# a Batocera box). The whole directory is mounted once at /data/roms; which
# subfolders are actually watched is controlled by config.json's
# "roms_folders" list, not by this file or docker-compose.yml.
#
# To watch an additional folder later: make sure it exists as a subfolder
# here, then run (see CONFIG_FOLDER below for what this command is):
#   docker compose run --rm --entrypoint /batocera-scrap-manager \
#     batocera-scrap-manager config add-roms-folder /data/roms/<system>
#   docker compose restart
# No edit to .env or docker-compose.yml needed.
#
# If your ROMs folders don't already share one parent directory (they sit on
# separate drives or network shares), create one on the host containing a
# symlink per folder, pointing at each real location, and point this
# variable at that folder instead.
ROMS_FOLDER=/path/to/roms

# Host path to a folder that will hold config.json (not the file itself: an
# empty or non-existent folder is fine, Docker creates it; a *missing file*
# bind-mounted directly would instead make Docker create a directory in its
# place, breaking the server — hence a folder here, holding the file inside
# it, always works). Owned by the container's uid too — see the ownership
# note above REGISTRY_FOLDER. Its "registry_folder" and "roms_folders" must
# point at paths under /data/registry and /data/roms, since those are the
# paths the container sees, not the host paths above — e.g. "/data/roms/snes",
# not the host path to that folder.
#
# config.json is not meant to be hand-edited: manage it with the `config`
# subcommand of the same image, run as a throwaway container so it works
# whether or not the server is currently running — useful for the very
# first setup, since the server refuses to start before a registry is
# configured:
#   docker compose run --rm --entrypoint /batocera-scrap-manager \
#     batocera-scrap-manager config set-registry /data/registry
#   docker compose run --rm --entrypoint /batocera-scrap-manager \
#     batocera-scrap-manager config add-roms-folder /data/roms/<system>
#   docker compose run --rm --entrypoint /batocera-scrap-manager \
#     batocera-scrap-manager config list
# Then start (or restart) the server so it picks up the change:
#   docker compose up -d
CONFIG_FOLDER=/path/to/config
